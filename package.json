  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "^20.17.0",
    "eslint": "9.22.0",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "2.1.9",
    "vue-tsc": "2.2.10"
  },
